<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RentUP.Cloud.Domain\RentUP.Cloud.Domain.csproj" />
    <ProjectReference Include="..\RentUP.Cloud.Application\RentUP.Cloud.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      FrameworkReference gives access to the full ASP.NET Core shared framework
      (IHttpContextAccessor, ClaimsPrincipal.FindFirstValue, AddHttpContextAccessor, etc.)
      without pulling in an old NuGet package. This is the correct pattern for
      non-Web classlibaries targeting net10.0 that need ASP.NET Core types.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
