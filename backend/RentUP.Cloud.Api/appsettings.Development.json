{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Supabase": {
    // Your Supabase project URL — e.g. https://abcdefgh.supabase.co
    // Found in: Supabase Dashboard → Project Settings → API → Project URL
    "ProjectUrl": "https://YOUR_PROJECT_REF.supabase.co",

    // JWKS endpoint for asymmetric ECC P-256 JWT validation (no shared secret needed)
    // Format: https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
    "JwksUrl": "https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json",

    // JWT issuer — always: https://YOUR_PROJECT_REF.supabase.co/auth/v1
    "ValidIssuer": "https://YOUR_PROJECT_REF.supabase.co/auth/v1",

    // JWT audience — always "authenticated" for Supabase user JWTs
    "ValidAudience": "authenticated"
  },
  "ConnectionStrings": {
    // Supabase Postgres connection string (use Session Mode pooler port 5432 for EF Core migrations,
    // Transaction Mode port 6543 for runtime — see Supabase Dashboard → Project Settings → Database)
    "DefaultConnection": "Host=aws-0-eu-central-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  }
}
