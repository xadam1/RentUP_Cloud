# ─────────────────────────────────────────────────────────────────────────────
# RentUP Cloud — Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL (found in: Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Your Supabase anon/public key (found in: Project Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# The base URL of your .NET backend API
VITE_API_BASE_URL=http://localhost:5000
